#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64) in;
layout(std430, buffer_reference, buffer_reference_align = 4)
readonly buffer source_t { uint words[]; };
layout(std430, buffer_reference, buffer_reference_align = 4)
writeonly buffer destination_t { uint words[]; };
layout(push_constant) uniform args_t
{
    source_t predicate;
    source_t src;
    destination_t dst;
    uint word_count;
};

void main()
{
    if (predicate.words[0] == 0)
        return;
    for (uint i = gl_GlobalInvocationID.x; i < word_count; i += gl_NumWorkGroups.x * 64)
        dst.words[i] = src.words[i];
}
